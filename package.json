{
  "name": "1harness",
  "version": "0.0.0",
  "private": true,
  "description": "A programmable control surface for agent harnesses, locally and remotely.",
  "bin": {
    "1harness": "./dist/cli.js"
  },
  "type": "module",
  "exports": {
    "./extension": {
      "types": "./src/extensions/api.ts",
      "default": "./dist/extensions/api.js"
    }
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsrs --project tsconfig.build.json",
    "typecheck": "tsrs --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@ff-labs/fff-node": "0.11.0",
    "@resvg/resvg-wasm": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "pele": "1.13.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tsrs": "0.20.1-ts7.1.0-beta"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.27.0"
}
